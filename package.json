{
  "name": "react-mobile-viewport",
  "version": "0.1.0",
  "description": "SSR-safe React hooks to detect mobile, tablet, and desktop viewports. Works with Next.js App Router.",
  "license": "MIT",
  "author": "Narges Abolhasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nargesabolhasan/react-mobile-viewport.git"
  },
  "bugs": {
    "url": "https://github.com/nargesabolhasan/react-mobile-viewport/issues"
  },
  "homepage": "https://github.com/nargesabolhasan/react-mobile-viewport#readme",
  "keywords": [
    "react",
    "nextjs",
    "next",
    "viewport",
    "mobile",
    "media-query",
    "matchMedia",
    "ssr",
    "hooks",
    "responsive"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./script": {
      "import": {
        "types": "./dist/script.d.ts",
        "default": "./dist/script.js"
      },
      "require": {
        "types": "./dist/script.d.cts",
        "default": "./dist/script.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
